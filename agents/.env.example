# ==============================================================================
# GrowEarn — CrewAI Multi-Agent Service Configuration (.env.example)
# ==============================================================================

# HMAC Authentication Shared Secret with Next.js (min 32 chars)
INTERNAL_SERVICE_KEY=""

# Groq LLM Inference API Key & Model
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Tavily Search API Key for Researcher Agent
TAVILY_API_KEY=""

# Base URL of GrowEarn Next.js Web Application
GROWEARN_API_BASE="http://127.0.0.1:3000"

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS="http://127.0.0.1:3000,http://localhost:3000"

# Host & Port for Agent FastAPI Service
AGENTS_HOST="127.0.0.1"
AGENTS_PORT="8000"
