# ==============================================================================
# Growearn — Production Environment Configuration (.env.example)
# ==============================================================================

# Database Configuration (PostgreSQL with pgvector extension)
DATABASE_URL="postgresql://growearn:growearn_secure_password@localhost:5432/growearn?schema=public"
DIRECT_URL="postgresql://growearn:growearn_secure_password@localhost:5432/growearn?schema=public"

# Authentication & Security (Google OAuth & Secure Cookie Session)
# AUTH_SECRET must be at least 32 characters long
AUTH_SECRET="your-secure-32-character-session-signing-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth 2.0 Credentials (obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Local BGE-M3 Embedding Service (Ollama / Local Model Serving Layer)
EMBEDDING_BASE_URL="http://127.0.0.1:11434"
BGE_M3_MODEL="bge-m3"

# Vector Search Tuning (HNSW Approximate Nearest Neighbors)
HNSW_EF_SEARCH="64"

# AI & LLM Services (Groq High-Speed LLM & LangChain)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# CrewAI Multi-Agent Service URL & Authentication
AGENTS_SERVICE_URL="http://localhost:8000"
INTERNAL_SERVICE_KEY="your-internal-agents-shared-secret-key-at-least-32-chars"

# Tavily Search API (Used for Learner AI Roadmaps and CrewAI Researcher Agent)
# Sign up at https://tavily.com to obtain an API key (e.g. tvly-...)
TAVILY_API_KEY=""

# ==============================================================================
# Cashfree Marketplace Payments Configuration (Sole Supported Gateway)
# ==============================================================================
# Environment: 'sandbox' (for testing: https://sandbox.cashfree.com/pg)
#              'production' (for live transactions: https://api.cashfree.com/pg)
CASHFREE_ENVIRONMENT="sandbox"
CASHFREE_CLIENT_ID="your_cashfree_app_id"
CASHFREE_CLIENT_SECRET="your_cashfree_secret_key"
CASHFREE_API_VERSION="2023-08-01"
PLATFORM_COMMISSION_PERCENT="10"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage Configuration
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION=""

# Production Telemetry & Guard
NODE_ENV="production"
APP_ENV="production"
LOG_LEVEL="info"
