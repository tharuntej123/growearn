# ==============================================================================
# Growearn — Production Environment Configuration (.env.example)
# ==============================================================================

# PostgreSQL Credentials (required for docker compose & local database setup)
POSTGRES_USER=growearn
POSTGRES_PASSWORD=
POSTGRES_DB=growearn

# Internal Service Shared Secret (HMAC authentication with Python CrewAI service; min 32 chars)
INTERNAL_SERVICE_KEY=

# Database Configuration (PostgreSQL with pgvector extension)
DATABASE_URL="postgresql://growearn:growearn_secure_password@localhost:5432/growearn?schema=public"
DIRECT_URL="postgresql://growearn:growearn_secure_password@localhost:5432/growearn?schema=public"

# Authentication & Security (Google OAuth & Secure Cookie Session)
# AUTH_SECRET must be at least 32 characters long
AUTH_SECRET="your-secure-32-character-session-signing-secret"
AUTH_URL="http://localhost:3000"

# Optional: exact OAuth redirect URI. Leave empty to use NEXT_PUBLIC_APP_URL + /api/auth/callback/google
# Register https://<your-domain>/api/auth/callback/google in Google Cloud Console.
GOOGLE_REDIRECT_URI=""

# Google OAuth 2.0 Credentials (obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Local BGE-M3 Embedding Service (Ollama / Local Model Serving Layer)
EMBEDDING_BASE_URL="http://127.0.0.1:11434"
BGE_M3_MODEL="bge-m3"

# Vector Search Tuning (HNSW Approximate Nearest Neighbors)
HNSW_EF_SEARCH="64"

# AI & LLM Services (Groq High-Speed LLM & LangChain)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# CrewAI Multi-Agent Service URL
AGENTS_SERVICE_URL="http://localhost:8000"

# Tavily Search API (Used for Learner AI Roadmaps and CrewAI Researcher Agent)
# Sign up at https://tavily.com to obtain an API key (e.g. tvly-...)
TAVILY_API_KEY=""

# ==============================================================================
# Cashfree Marketplace Payments Configuration (Sole Supported Gateway)
# ==============================================================================
# Environment: 'sandbox' (for testing: https://sandbox.cashfree.com/pg)
#              'production' (for live transactions: https://api.cashfree.com/pg)
CASHFREE_ENVIRONMENT="sandbox"
CASHFREE_CLIENT_ID="your_cashfree_app_id"
CASHFREE_CLIENT_SECRET="your_cashfree_secret_key"
CASHFREE_API_VERSION="2023-08-01"
PLATFORM_COMMISSION_PERCENT="10"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# File Storage (resumes and other uploads)
# ==============================================================================
# SUPPORTED FOR PRODUCTION TODAY: "local" (disk). With Docker, /app/storage is a persistent
# volume (see docker-compose.yml). Use a single app instance, or share that volume.
# "s3", "r2" and "gcs" are NOT production-ready yet: they do not sign requests and will
# fail with a clear error. Do not use them until they are implemented with the provider SDK.
STORAGE_PROVIDER="local"
# Secret used to sign download links; defaults to AUTH_SECRET if empty (min 32 chars)
STORAGE_SIGNING_SECRET=""
# --- Only read by the (not yet production-ready) cloud providers ---
AWS_S3_BUCKET=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL=""
GCS_BUCKET=""

# First-admin bootstrap: if set and the database has zero ADMIN users, this email becomes ADMIN on first sign-in
ADMIN_BOOTSTRAP_EMAIL=""

# Optional AI settings
DISABLE_EMBEDDINGS="false"        # true = skip embedding calls (search falls back to keyword ranking)
LANGCHAIN_TRACING_ENABLED="false"
# MOCK_AI must stay unset/false in production (the app refuses to start if it is true)
# NEXT_PUBLIC_APP_ENV="demo"       # only for a demo deployment; shows the demo notice in the footer
# ALLOW_PRODUCTION_SEED must NEVER be set on a real database

# Production Telemetry & Guard
NODE_ENV="production"
APP_ENV="production"
LOG_LEVEL="info"
